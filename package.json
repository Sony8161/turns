{
  "name": "turn-system",
  "private": true,
  "version": "0.1.0",
  "description": "Digital technician turn system for nail salons. Web (Next.js), mobile (Expo), shared db package.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "node scripts/scan-public-env.mjs",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/down.ps1",
    "bundle:scan": "node scripts/scan-bundle.mjs",
    "pages:scan": "node scripts/scan-pages.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.2"
  }
}
