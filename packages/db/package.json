{
  "name": "@turn/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./server": "./src/server.ts",
    "./invites": "./src/invites.ts",
    "./setup": "./src/setup.ts",
    "./status": "./src/status.ts",
    "./engine": "./src/engine.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./rules": "./src/rules.ts",
    "./staff": "./src/staff.ts",
    "./seed": "./src/seed.ts",
    "./profile": "./src/profile.ts",
    "./clients": "./src/clients.ts",
    "./appointments": "./src/appointments.ts",
    "./feeds": "./src/feeds.ts",
    "./locations": "./src/locations.ts",
    "./reports": "./src/reports.ts",
    "./kiosk": "./src/kiosk.ts",
    "./fresha": "./src/fresha.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
